def wheel_error(error: dict, *, category_codes=None) -> ClientError:
    """Map only the code; preserve Rust's message, action and retryability."""
    wheel = _load_wheel()
    encoded = json.dumps(error)
    try:
        category, retryable = wheel.category(encoded), wheel.retryable(encoded)
    except Exception as exc:
        raise _invalid("sc-decidr could not classify the result") from exc
    if not isinstance(category, str) or type(retryable) is not bool or not isinstance(error.get("message"), str):
        raise _invalid("sc-decidr returned an invalid typed error")
    codes = {**DECIDR_CATEGORY_CODES, **(category_codes or {})}
    key = "context_exceeded" if error.get("id") == "decision.context_exceeded" else category
    code = codes.get(key) or codes["other"]
    return ClientError(code, error["message"], retryable, error.get("recovery"),
                       **error_metadata(error), data=dict(error))


def _failed(error):
