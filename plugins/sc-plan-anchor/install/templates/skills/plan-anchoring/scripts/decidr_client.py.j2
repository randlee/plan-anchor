def exception_result(exc: Exception, *, category_codes=None) -> dict:
    if isinstance(exc, ClientError):
        return _failed(exc)
    detail = exc.detail
    detail = json.loads(detail) if isinstance(detail, str) else detail
    detail = dict(detail) if isinstance(detail, dict) else {}
    for key in ("id", "message", "category", "status", "attempts", "retry_after_ms"):
        value = getattr(exc, key, None)
        if value is not None:
            detail[key] = value
    return _failed(wheel_error(detail, category_codes=category_codes))


class NoulAnswer(NamedTuple):
    noul: float


class ChoiceAnswer(NamedTuple):
    choice: str
    confidence: float
    probabilities: Mapping[str, float]


class ScoreAnswer(NamedTuple):
    score: float
    confidence: float
    legend: Mapping[str, Any]
    probabilities: Mapping[str, float]


class BoxAnswer(NamedTuple):
    top: float
    bottom: float
    left: float
    right: float
    confidence: Optional[float]


def _typed_answer(answer):
    """Normalize valid wheel and JSON fixture answers without requiring the wheel offline."""
    if isinstance(answer, (NoulAnswer, ChoiceAnswer, ScoreAnswer, BoxAnswer)):
        return answer
    if isinstance(answer, dict):
        try:
            kind = answer.get("type") or next((key for key in ("noul", "choice", "score", "box") if key in answer), None)
            if kind == "noul":
                return NoulAnswer(answer["noul"])
            if kind == "choice":
                return ChoiceAnswer(answer["choice"], answer["confidence"], answer["probabilities"])
            if kind == "score":
                return ScoreAnswer(answer["score"], answer["confidence"], answer["legend"], answer["probabilities"])
            if kind == "box":
                box = answer["box"]
                return BoxAnswer(box["top"], box["bottom"], box["left"], box["right"], answer.get("confidence"))
        except (KeyError, TypeError):
            pass
        return answer
    if hasattr(answer, "noul"):
        return NoulAnswer(answer.noul)
    if hasattr(answer, "choice"):
        return ChoiceAnswer(answer.choice, answer.confidence, answer.probabilities)
    if hasattr(answer, "score"):
        return ScoreAnswer(answer.score, answer.confidence, answer.legend, answer.probabilities)
    if hasattr(answer, "top"):
        return BoxAnswer(answer.top, answer.bottom, answer.left, answer.right, answer.confidence)
    return answer


def decode_result(line: str, *, category_codes=None) -> dict:
    """Decode one Rust wire result, retaining its position and observed sends."""
    try:
        parsed = _load_wheel().parse_result(line)
        sends = parsed["sends"]
        attempts = sends if type(sends) is int and sends >= 0 else None
        if parsed["error"] is not None:
            result = exception_result(parsed["error"], category_codes=category_codes)
            result["error"].attempts = attempts
        else:
            response = json.loads(line).get("response", {})
            answers = {key: _typed_answer(answer) for key, answer in parsed["answers"].items()}
            result = dict(ok=True, value=answers, usage=parsed["usage"], model_answered=response.get("model"))
        result.update(position=parsed["position"], session_id=parsed["session_id"],
                      digests=parsed["digests"], line=line, attempts=attempts)
        return result
    except (TypeError, ValueError) as exc:
        return _failed(_invalid(f"sc-decidr returned invalid JSON: {exc}"))
    except ClientError as exc:
        return _failed(exc)


def _invoke(method, request, abort_on, kwargs, category_codes, *, repository_root=".", consent_what="The request text"):
    if frozenset(abort_on) not in _ALLOWED_ABORT_ON:
        raise ClientError("DECIDR.INVALID_OPTION", "abort_on must be {}, {'auth'}, or {'auth', 'quota'}")
    try:
        remote_preflight(repository_root=repository_root, what=consent_what)
    except ClientError as exc:
        return _failed(exc)
    try:
        wheel = _load_wheel()
    except ClientError as exc:
        return _failed(exc)
    kwargs["cancel"] = kwargs.get("cancel") if kwargs.get("cancel") is not None else wheel.CancelToken()
    try:
        if method == "send":
            request = _encode_request(request)
        elif method == "send_batch":
            request = [_encode_batch_item(item) for item in request]
        return dict(ok=True, value=getattr(wheel, method)(request, **kwargs))
    except KeyboardInterrupt:
        kwargs["cancel"].cancel()
        raise
    except wheel.SagError as exc:
        if exc.category in abort_on:
            kwargs["cancel"].cancel()
        return exception_result(exc, category_codes=category_codes)
    except ClientError as exc:
        return _failed(exc)


def _encode_request(request: Request) -> str:
    if isinstance(request, str):
        return request
    if isinstance(request, dict):
        return json.dumps(request)
    raise ClientError("DECIDR.INVALID_REQUEST", "request must be a JSON string or object")


def _encode_batch_item(item: BatchItem):
    if isinstance(item, tuple):
        if len(item) != 3:
            raise ClientError("DECIDR.INVALID_REQUEST", "batch tuple must be (request, images, long_context)")
        request, images, long_context = item
        return (_encode_request(request), images, long_context)
    return _encode_request(item)


def call_result(
    request: Request, *, model: str, project: str, agent_role: str, abort_on: AbortOn,
    category_codes: Optional[CategoryCodes] = None, cancel: Optional["CancelToken"] = None,
    images: Optional[dict[str, bytes]] = None, long_context: bool = False,
    config_dir: Optional[str] = None, keyring_service: Optional[str] = None, keyring_account: Optional[str] = None,
    general_log: Optional[LogSink] = None,
    timeout_secs: Optional[float] = None,
    consent_what: str = "The request text", repository_root: str = ".",
) -> dict:
    kwargs = dict(model=model, project=project, agent_role=agent_role, cancel=cancel, images=images,
                  long_context=long_context, config_dir=config_dir, keyring_service=keyring_service,
                  keyring_account=keyring_account)
    kwargs["general_log"] = general_log
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    sent = _invoke("send", request, abort_on, kwargs, category_codes, repository_root=repository_root, consent_what=consent_what)
    if not sent["ok"]:
        return sent
    result = decode_result(sent["value"], category_codes=category_codes)
    if not result["ok"] and (result["error"].data or {}).get("category") in abort_on:
        kwargs["cancel"].cancel()
    return result


def call_batch_results(
    requests: Sequence[BatchItem], *, model: str, project: str, agent_role: str, abort_on: AbortOn,
    category_codes: Optional[CategoryCodes] = None, cancel: Optional["CancelToken"] = None,
    config_dir: Optional[str] = None, keyring_service: Optional[str] = None, keyring_account: Optional[str] = None,
    general_log: Optional[LogSink] = None,
    timeout_secs: Optional[float] = None, workers: Optional[int] = None,
    on_result: Optional[Callable[[dict], None]] = None,
    consent_what: str = "The request text", repository_root: str = ".",
) -> dict:
    completed, decoded = {}, {}

    def record(line):
        if line in decoded:
            return decoded[line]
        result = decode_result(line, category_codes=category_codes)
        position = result["position"]
        if type(position) is not int or not 0 <= position < len(requests) or position in completed:
            raise _invalid("sc-decidr batch result has an invalid or repeated input position")
        completed[position] = decoded[line] = result
        if not result["ok"] and (result["error"].data or {}).get("category") in abort_on:
            kwargs["cancel"].cancel()
        if on_result is not None:
            on_result(result)
        return result

    kwargs = dict(model=model, project=project, agent_role=agent_role, cancel=cancel, on_result=record,
                  config_dir=config_dir, keyring_service=keyring_service, keyring_account=keyring_account)
    kwargs["general_log"] = general_log
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    if workers is not None:
        kwargs["workers"] = workers
    sent = _invoke("send_batch", requests, abort_on, kwargs, category_codes, repository_root=repository_root, consent_what=consent_what)
    if not sent["ok"]:
        return sent
    try:
        if len(sent["value"]) != len(requests):
            raise _invalid(f"sc-decidr returned {len(sent['value'])} results for {len(requests)} batch requests")
        for line in sent["value"]:
            record(line)
        if len(completed) != len(requests):
            raise _invalid("sc-decidr batch results repeat an input position")
    except ClientError as exc:
        return _failed(exc)
    return dict(ok=True, value=[completed[position] for position in range(len(requests))])


