def from_tool_error(error: Any) -> ClientError:
    """A consumer Result error (a ClientError, or a ToolError with code, message, action, data) as a ClientError."""
    if isinstance(error, ClientError):
        return error
    fields = cast(Record, error) if isinstance(error, dict) else {
        key: getattr(error, key, None) for key in ("code", "message", "action", "data")}
    code, message = fields.get("code", fields.get("id")), fields.get("message")
    data = fields.get("data")
    return ClientError(code if isinstance(code, str) else "DECIDR.ERROR",
                       message if isinstance(message, str) else "Unknown tool error",
                       action=fields.get("action"), data=dict(cast(Mapping[str, Any], data)) if isinstance(data, Mapping) else None)


CANCELED_EXIT = 130


def canceled_envelope() -> Record:
    out = ClientError("CANCELED", "interrupted before the command finished", True,
                      "Rerun the command; nothing partial was reported as complete.").to_json()
    out.update(canceled=True, aborted_by="user")
    return out


class NoulAnswer(NamedTuple):
    noul: float


class ChoiceAnswer(NamedTuple):
    choice: str
    confidence: float
    probabilities: Mapping[str, float]


class ScoreAnswer(NamedTuple):
    score: float
    confidence: float
    legend: Mapping[str, Any]
    probabilities: Mapping[str, float]


class BoxAnswer(NamedTuple):
    top: float
    bottom: float
    left: float
    right: float
    confidence: float | None


def typed_answer(answer: Any) -> Any:
    """A JSON answer object as its typed answer; anything else, malformed objects included, unchanged."""
    if not isinstance(answer, dict):
        return answer
    wire = cast(Record, answer)
    kind = wire.get("type") or next((key for key in ("noul", "choice", "score", "box") if key in wire), None)
    try:
        match kind:
            case "noul":
                return NoulAnswer(wire["noul"])
            case "choice":
                return ChoiceAnswer(wire["choice"], wire["confidence"], wire["probabilities"])
            case "score":
                return ScoreAnswer(wire["score"], wire["confidence"], wire["legend"], wire["probabilities"])
            case "box":
                box = wire["box"]
                return BoxAnswer(box["top"], box["bottom"], box["left"], box["right"], wire.get("confidence"))
            case _:
                pass
    except (KeyError, TypeError):
        pass
    return wire


def _failure(code: str, message: str, category: str = "other",
             action: str = "Read the error and fix the named input or dependency.") -> Record:
    """A failure in the wheel's own result shape."""
    return {"ok": False, "error": {"id": code, "message": message, "action": action, "category": category}}


def _failed(error: ClientError) -> Record:
    return {"ok": False, "error": error, "position": None, "line": None, "attempts": error.attempts}


def load_wheel():
    try:
        import sc_agent
    except ImportError as exc:
        return _failure("DEPENDENCY.SC_DECIDR", str(exc), action="Install sc-decidr in the active Python environment.")
    return sc_agent


def _logger(create: Callable[[str], Record], injected: Any) -> Record:
    """The caller's Logger, else this client's one Logger, created on first use."""
    global _logger_handle
    with _logger_lock:
        if injected is None and _logger_handle is None:
            created = create(CLIENT_NAME)
            if not created["ok"]:
                return created
            _logger_handle = created["value"]
        return {"ok": True, "value": _logger_handle if injected is None else injected}


def wheel_error(detail: Record, *, category_codes: Mapping[str, str] | None = None) -> ClientError:
    """The wheel's error value as a ClientError coded by its category."""
    codes = {**DECIDR_CATEGORY_CODES, **(category_codes or {})}
    identifier, category = detail.get("id"), detail.get("category", "other")
    if identifier in _CLIENT_IDS:
        code = identifier
    else:
        code = codes.get("context_exceeded" if identifier == "decision.context_exceeded" else category, codes["other"])
    counts = {key: value if type(value := detail.get(key)) is int and value >= 0 else None
              for key in ("status", "retry_after_ms", "attempts")}
    return ClientError(code, detail.get("message", "invalid result"), category in {"busy", "network"},
                       detail.get("action"), **counts, data=dict(detail))


def decode_result(value: str | Record, *, category_codes: Mapping[str, str] | None = None) -> Record:
    """The wheel's result envelope as the consumer's result record."""
    try:
        decoded: object = json.loads(value) if isinstance(value, str) else value
        if not isinstance(decoded, dict) or type(cast(Record, decoded).get("ok")) is not bool:
            return _invalid_result("expected an ok/value or ok/error envelope")
        envelope = cast(Record, decoded)
        line = json.dumps(envelope)
        if envelope["ok"]:
            body: Record = envelope["value"]
            result: Record = {"ok": True, "value": {key: typed_answer(answer) for key, answer in body["answers"].items()},
                              "usage": body.get("usage"), "model_answered": body.get("model")}
        else:
            body = envelope["error"]
            result = _failed(wheel_error(body, category_codes=category_codes))
        result.update(position=envelope.get("index"), session_id=body.get("session_id"),
                      digests=body.get("question_digests", {}), line=line, attempts=body.get("attempts"))
        return result
    except (AttributeError, KeyError, TypeError, ValueError) as exc:
        return _invalid_result(exc)


def _invalid_result(reason: object) -> Record:
    return _failed(ClientError("DECIDR.INVALID_RESULT", f"sc-decidr returned an invalid result: {reason}",
                               action="Inspect the invalid sc-decidr result and check the wheel and client versions."))


def _abort_if_selected(line: object, abort_on: frozenset[str], cancel: Cancel) -> None:
    error = cast(Record, line).get("error") if isinstance(line, dict) else None
    if isinstance(error, dict) and cast(Record, error).get("category") in abort_on:
        cancel.cancel()


def _as_text(request: str | Record) -> str:
    return json.dumps(request) if isinstance(request, dict) else request


def _start(abort_on: frozenset[str], category_codes: Mapping[str, str] | None, repository_root: str, consent_what: str):
    """Check ``abort_on`` and consent, then load the wheel: the wheel module, or a failed record."""
    try:
        valid_abort = frozenset(abort_on) in _ALLOWED_ABORT_ON
    except (TypeError, ValueError):
        valid_abort = False
    if not valid_abort:
        invalid = _failure("DECIDR.INVALID_OPTION", "abort_on must be {}, {'auth'}, or {'auth', 'quota'}", "validation")
        return decode_result(invalid, category_codes=category_codes)
    allowed = remote_preflight(repository_root, consent_what)
    if not allowed["ok"]:
        return allowed
    sc_agent = load_wheel()
    return decode_result(sc_agent, category_codes=category_codes) if isinstance(sc_agent, dict) else sc_agent


def call_result(request: str | Record, *, model: str, project: str | None = None,
                abort_on: frozenset[str] = frozenset(), category_codes: Mapping[str, str] | None = None,
                cancel: Cancel | None = None, config_dir: str | None = None, general_log: Any = None,
                timeout_secs: float | None = None, repository_root: str = ".",
                consent_what: str = "The request text") -> Record:
    """Send one decision request and return the consumer result record."""
    sc_agent = _start(abort_on, category_codes, repository_root, consent_what)
    if isinstance(sc_agent, dict):
        return sc_agent
    logger = _logger(sc_agent.logger, general_log)
    if not logger["ok"]:
        return decode_result(logger, category_codes=category_codes)
    cancel = cancel or sc_agent.Cancel()
    try:
        line: Any = sc_agent.send(_as_text(request), model=model, project=project, agent_role=CLIENT_NAME, cancel=cancel,
                                  config_dir=config_dir, general_log=logger["value"], timeout_secs=timeout_secs)
    except KeyboardInterrupt:
        cancel.cancel()
        line = _failure("decision.cancelled", "interrupted", "cancelled")
    _abort_if_selected(line, abort_on, cancel)
    return decode_result(line, category_codes=category_codes)


def call_batch_results(requests: Sequence[str | Record], *, model: str, project: str | None = None,
                       abort_on: frozenset[str] = frozenset(), category_codes: Mapping[str, str] | None = None,
                       cancel: Cancel | None = None, config_dir: str | None = None, general_log: Any = None,
                       timeout_secs: float | None = None, repository_root: str = ".",
                       consent_what: str = "The request text", workers: int | None = None,
                       on_result: Callable[[Record], None] | None = None) -> Record:
    """Send a batch; the records come back in input order, ``on_result`` sees each as it finishes."""
    sc_agent = _start(abort_on, category_codes, repository_root, consent_what)
    if isinstance(sc_agent, dict):
        return sc_agent
    logger = _logger(sc_agent.logger, general_log)
    if not logger["ok"]:
        return decode_result(logger, category_codes=category_codes)
    cancel = cancel or sc_agent.Cancel()
    finished: list[Record] = []

    def handle(index: int, line: Record) -> None:
        line = dict(line, index=index)
        finished.append(line)
        _abort_if_selected(line, abort_on, cancel)
        if on_result is not None:
            on_result(decode_result(line, category_codes=category_codes))

    try:
        batch = sc_agent.send_batch([_as_text(request) for request in requests], model=model, project=project,
                                    agent_role=CLIENT_NAME, cancel=cancel, config_dir=config_dir, general_log=logger["value"],
                                    timeout_secs=timeout_secs, workers=workers, on_result=handle)
    except KeyboardInterrupt:
        cancel.cancel()
        lines = finished
    else:
        if not batch["ok"]:
            _abort_if_selected(batch, abort_on, cancel)
            return decode_result(batch, category_codes=category_codes)
        lines = [dict(item["result"], index=item["index"]) for item in batch["value"]]
    return {"ok": True, "value": [decode_result(line, category_codes=category_codes) for line in lines]}


REMOTE_JUDGE_SETTING = ".sc/plan-anchor/settings.yaml"
REMOTE_JUDGE_SET = "python3 scripts/plan_anchor_settings.py set allow_remote_judge true|false"
REPO_ROOT_HELP = (f"any path inside the repository; the nearest {REMOTE_JUDGE_SETTING} at or above it holds "
                  "allow_remote_judge (read for live Jev calls only; default .)")


def remote_judge_consent(repository_root: str = ".", what: str = "The request text") -> Record:
    """Require an affirmative, repository-local consent setting before any remote send."""
    try:
        settings = importlib.import_module("plan_anchor_settings")
    except ImportError as exc:
        return _failed(ClientError("DEPENDENCY.SETTINGS", f"the consent settings module could not be imported: {exc}",
                                   action="Install the consumer's settings module before making a live Jev call."))
    start = pathlib.Path(repository_root or ".").resolve()
    root = settings.find_repo_root(start)
    if not root.ok:
        return _failed(from_tool_error(root.error))
    answer = settings.remote_judge_consent(start)
    if answer.ok and answer.value is True:
        return {"ok": True, "value": None}
    disabled = f"Sending text to TypeSafe is disabled. {what} would leave this machine."
    if answer.ok:
        return _failed(ClientError("POLICY.REMOTE_JUDGE_DISABLED",
                                   f"{disabled} {REMOTE_JUDGE_SETTING} sets allow_remote_judge: false.",
                                   action="The user declined remote judging; only the user changes this setting and commits it. Use --dry-run to inspect the request instead."))
    if answer.error.code == "SETTINGS.REMOTE_JUDGE_UNSET":
        return _failed(ClientError("POLICY.REMOTE_JUDGE_DISABLED",
                                   f"{disabled} {REMOTE_JUDGE_SETTING} does not set allow_remote_judge.",
                                   action=f"Ask the user once whether this text may be sent to TypeSafe (Jev), record the answer with `{REMOTE_JUDGE_SET}`, and commit {REMOTE_JUDGE_SETTING}. Never infer consent from prior runs. Use --dry-run to inspect the request instead."))
    return _failed(from_tool_error(answer.error))


def remote_preflight(repository_root: str = ".", what: str = "The request text") -> Record:
    """Shared send gate; callers cannot inject or override the consent value."""
    return remote_judge_consent(repository_root, what)


BATCH_RESULT_SCHEMA = "jev-batch-result/1"
BATCH_MAX_WORKERS = 4
BATCH_RETRIES = 1
BATCH_FIXTURE_ERROR = "__error__"

BATCH_ID_RE = r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"


class BatchSettings(NamedTuple):
    gate: str
    model: str
    repeat: int
    prefix: str
    threshold: float
    timeout: float
    max_workers: int
    max_request_bytes: int
    dry_run: bool


class BatchJob(NamedTuple):
    item_id: str
    anchor_id: str | None
    candidate_id: str
    repeat: int
    request_id: str
    body: Record
    questions: Record
    roles: Record
    kind: str


class StreamedResult(NamedTuple):
    failed: list[Record]
    attempts: int


def batch_request_id(prefix: str, item_id: str, anchor_id: str | None, candidate_id: str, repeat: int) -> str:
    if anchor_id is None:
        return f"{prefix}/{item_id}/{candidate_id}/r{repeat}"
    return f"{prefix}/{item_id}/{anchor_id}/{candidate_id}/r{repeat}"


def _sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def questions_digest(questions: Record) -> str:
    """The canonical questions digest."""
    return _sha256(json.dumps(questions, sort_keys=True, separators=(",", ":"), ensure_ascii=False))


def safe_id(value: object, what: str) -> Record:
    if isinstance(value, str) and re.fullmatch(BATCH_ID_RE, value):
        return {"ok": True, "value": value}
    return _failed(ClientError("VALIDATION.INPUT", f"{what} {value!r} is not a safe id (letters, digits and _.:- only)",
                               action="See the consumer's Jev batch request schema."))


def _fixture_keys(job: BatchJob) -> tuple[str, ...]:
    return (f"{job.item_id}/{job.candidate_id}/r{job.repeat}",
            f"{job.item_id}/{job.candidate_id}", job.candidate_id, "*")


def _fixture_missing(keys: tuple[str, ...]) -> ClientError:
    return ClientError("FIXTURE.MISSING",
                       f"answers fixture has no entry for {keys[0]} (or {keys[1]}, {keys[2]}, '*')",
                       action=f"Add an entry for {keys[0]} to the answers file.")


def fixture_attempt(
        job: BatchJob, fixture: Mapping[str, Any], attempt: int, *,
        transient_codes: Container[str] = frozenset()) -> Record:
    keys = _fixture_keys(job)
    entry = next((fixture[key] for key in keys if key in fixture), None)
    if entry is None:
        return _failed(_fixture_missing(keys))
    if isinstance(entry, list):
        attempts = cast(list[Any], entry)
        if not attempts:
            return _failed(ClientError("FIXTURE.MISSING", f"answers fixture entry for {keys[0]} is an empty list"))
        entry = attempts[min(attempt, len(attempts)) - 1]
    if not isinstance(entry, dict):
        return _failed(ClientError("INPUT.MALFORMED", f"answers fixture entry for {keys[0]} must be an object"))
    wire = cast(Record, entry)
    if BATCH_FIXTURE_ERROR in wire:
        code = str(wire[BATCH_FIXTURE_ERROR])
        return _failed(ClientError(code, f"fixture failure {code}", code in transient_codes))
    answers = {key: typed_answer(answer) for key, answer in wire.items()}
    if set(answers) != set(job.questions):
        return _failed(ClientError("DECIDR.RESPONSE_INVALID", "fixture answer IDs do not match question IDs"))
    for key, answer in answers.items():
        if not _valid_fixture_answer(answer, job.questions[key]):
            return _failed(ClientError("DECIDR.RESPONSE_INVALID", f"invalid fixture answer for {key}"))
    return {"ok": True, "value": {"model": "fixture", "answers": answers}}


def _number(value: object) -> TypeGuard[int | float]:
    try:
        return (type(value) is int or type(value) is float) and math.isfinite(value)
    except OverflowError:  # an int too large for a float
        return False


def _probability(value: object) -> bool:
    return _number(value) and 0 <= value <= 1


def _probabilities(value: object) -> bool:
    return isinstance(value, Mapping) and all(isinstance(key, str) and _probability(item)
                                              for key, item in cast(Mapping[object, object], value).items())


def _valid_fixture_answer(answer: object, question: object) -> bool:
    """Whether a typed fixture answer has the wheel's shape for its question's type."""
    if not isinstance(question, Mapping):
        return False
    shape = cast(Mapping[str, Any], question)
    kind = shape.get("type", "choice")
    # The answer was built from unvalidated fixture JSON, so its fields are checked as plain objects.
    match answer:
        case NoulAnswer(noul):
            return kind == "noul" and _probability(noul)
        case ChoiceAnswer(choice, confidence, probabilities):
            if not (kind == "choice" and isinstance(cast(object, choice), str) and _probability(confidence)
                    and _probabilities(probabilities)):
                return False
            criteria = shape.get("criteria")
            if isinstance(criteria, Mapping) and criteria:
                options = set(cast(Mapping[str, object], criteria))
                if choice not in options or set(probabilities) != options:
                    return False
            return abs(sum(probabilities.values()) - 1) <= 0.01 * max(len(probabilities), 1)
        case ScoreAnswer(score, confidence, legend, probabilities):
            return (kind == "score" and _number(score) and _probability(confidence)
                    and isinstance(cast(object, legend), Mapping) and _probabilities(probabilities))
        case BoxAnswer(top, bottom, left, right, confidence):
            return (kind == "box" and all(_number(side) for side in (top, bottom, left, right))
                    and (confidence is None or _probability(confidence)))
        case _:
            return False


def batch_settings(args: Any, prefix: str, *, check_threshold: Callable[[Any], Any],
                   request_cap: Callable[[str, Any], Any]) -> Record:
    """Common batch settings; the consumer supplies its threshold and request-cap rules."""
    gate, repeat = getattr(args, "gate", "plan"), getattr(args, "repeat", 1)
    if repeat < 1:
        return _failed(ClientError("VALIDATION.INPUT", "--repeat must be at least 1"))
    if not 1 <= args.max_workers <= BATCH_MAX_WORKERS:
        return _failed(ClientError("VALIDATION.INPUT", f"--max-workers must be between 1 and {BATCH_MAX_WORKERS}"))
    if not prefix or any(char.isspace() for char in prefix):
        return _failed(ClientError("VALIDATION.INPUT", "--request-prefix must be non-empty and contain no whitespace"))
    threshold = check_threshold(getattr(args, "threshold", 0.6))
    if not threshold.ok:
        return _failed(from_tool_error(threshold.error))
    cap = request_cap(gate, getattr(args, "max_request_bytes", None))
    if not cap.ok:
        return _failed(from_tool_error(cap.error))
    return {"ok": True, "value": BatchSettings(gate, args.model, repeat, prefix, threshold.value, args.timeout,
                                               args.max_workers, cap.value, bool(args.dry_run))}


def result_line(
        job: BatchJob, settings: BatchSettings, raw: Record | None, attempts: list[Record],
        error: ClientError | None, dry_run: bool, *,
        result_fields: Callable[[BatchJob, BatchSettings, Record | None], Record] | None = None,
        error_message_limit: int | None = None) -> Record:
    """The one durable batch result line. ``raw`` is a raw answer or a successful call record."""
    sends = None
    if raw is not None and type(raw.get("ok")) is bool:  # a call record
        sends = raw.get("attempts")
        if raw["ok"]:
            raw = {"model": raw.get("model_answered"), "answers": raw.get("value"), "sends": sends}
        else:
            error, raw = from_tool_error(raw.get("error")), None
    elif error is not None:
        sends = error.attempts
    if type(sends) is not int or sends < 0:
        sends = None
    line: Record = {
        "schema": BATCH_RESULT_SCHEMA, "request_id": job.request_id, "run_id": _sha256(job.request_id)[:16],
        "item_id": job.item_id, "anchor_id": job.anchor_id, "candidate_id": job.candidate_id, "repeat": job.repeat,
        "request_sha256": _sha256(json.dumps(job.body, allow_nan=False)),
        "questions_sha256": questions_digest(job.questions), "request": job.body, "roles": job.roles, "kind": job.kind,
        "dry_run": dry_run, "ok": raw is not None, "raw_response": raw,
        "answers": None if raw is None else raw.get("answers"),
        "model_answered": None if raw is None else raw.get("model"),
        "sends": sends,
        "threshold": settings.threshold, "verdict": None, "min_confidence": None, "leaning": None,
        "retry_count": max((len(attempts) if sends is None else sends) - 1, 0), "attempts": attempts,
        "error": None if error is None else {"code": error.code, "message": error.message[:error_message_limit],
                                             "recoverable": error.retryable},
    }
    if error is not None and error.action is not None:
        line["error"]["suggested_action"] = error.action
    line.update(result_fields(job, settings, raw) if result_fields is not None else {})
    return line


def _jobs(lines: list[Any], settings: BatchSettings, question_sets: Any,
          make_jobs: Callable[[Any, int, BatchSettings, Any], Any]) -> Record:
    """Every job of the request stream, or the first invalid line or repeated request id."""
    jobs: list[BatchJob] = []
    request_ids: set[str] = set()
    for number, line in enumerate(lines, start=1):
        made = make_jobs(line, number, settings, question_sets)
        if not made.ok:
            return _failed(from_tool_error(made.error))
        for job in made.value:
            if job.request_id in request_ids:
                return _failed(ClientError("VALIDATION.INPUT", f"request {job.request_id} appears twice in the stream",
                                           action="Pair each item, anchor and candidate once; use --repeat for repeats."))
            request_ids.add(job.request_id)
            jobs.append(job)
    return {"ok": True, "value": jobs}


def validate_request_lines(lines: list[Any], settings: BatchSettings, question_sets: Any,
                           make_jobs: Callable[[Any, int, BatchSettings, Any], Any]) -> Record:
    """Validate all input before sending; the value is the number of jobs."""
    jobs = _jobs(lines, settings, question_sets, make_jobs)
    return {"ok": True, "value": len(jobs["value"])} if jobs["ok"] else jobs


def check_fixture_coverage(lines: list[Any], settings: BatchSettings, question_sets: Any,
                           make_jobs: Callable[[Any, int, BatchSettings, Any], Any], fixture: Any) -> Record:
    """Check every fixture key before the first request, so an incomplete fixture cannot partially run."""
    if fixture is None or settings.dry_run:
        return {"ok": True, "value": None}
    jobs = _jobs(lines, settings, question_sets, make_jobs)
    if not jobs["ok"]:
        return jobs
    for job in jobs["value"]:
        keys = _fixture_keys(job)
        if not any(key in fixture for key in keys):
            return _failed(_fixture_missing(keys))
    return {"ok": True, "value": None}


def load_answers_fixture(path: str, keyed_by: str, loader: Callable[[str, str], Any], *,
                         validate_envelope: Callable[[Any, str], Any] | None = None) -> Record:
    """Load the consumer's answer fixture using its strict JSON/question schema parser."""
    if not path:
        return {"ok": True, "value": None}
    loaded = loader(path, "answers fixture")
    if not loaded.ok:
        return _failed(from_tool_error(loaded.error))
    fixture: Any = loaded.value
    if not isinstance(fixture, dict):
        return _failed(ClientError("INPUT.MALFORMED", f"answers fixture must be an object keyed by {keyed_by} (or '*')"))
    if validate_envelope is not None and (error := validate_envelope(fixture, f"answers fixture {path}")) is not None:
        return _failed(from_tool_error(error))
    return {"ok": True, "value": fixture}


def write_stdout_line(text: str) -> None:
    """Write a UTF-8 JSONL record without Windows text-mode newline translation."""
    buffer = getattr(sys.stdout, "buffer", None)
    if buffer is None:
        sys.stdout.write(text)
        sys.stdout.flush()
    else:
        sys.stdout.flush()
        buffer.write(text.encode("utf-8"))
        buffer.flush()


def json_answers(value: Any) -> Any:
    """``value`` with every typed answer, at any depth, replaced by its JSON wire shape."""
    match value:
        case NoulAnswer(noul):
            return {"type": "noul", "noul": noul}
        case ChoiceAnswer(choice, confidence, probabilities):
            return {"type": "choice", "choice": choice, "confidence": confidence, "probabilities": dict(probabilities)}
        case ScoreAnswer(score, confidence, legend, probabilities):
            return {"type": "score", "score": score, "confidence": confidence,
                    "legend": dict(legend), "probabilities": dict(probabilities)}
        case BoxAnswer(top, bottom, left, right, confidence):
            return {"type": "box", "box": {"top": top, "bottom": bottom, "left": left, "right": right},
                    "confidence": confidence}
        case dict():
            return {key: json_answers(item) for key, item in cast(Record, value).items()}
        case list() | tuple():
            return [json_answers(item) for item in cast(Sequence[Any], value)]
        case _:
            return value


def _unserializable(value: object) -> Record:
    return _failure("DECIDR.INVALID_RESULT", f"Object of type {type(value).__name__} is not JSON serializable")


def encode_result_line(line: Record, *, redact: Callable[[Any], Any] | None = None) -> str:
    serializable = json_answers(line)
    return json.dumps(redact(serializable) if redact is not None else serializable,
                      ensure_ascii=False, default=_unserializable) + "\n"


def total_attempts(results: list[Record]) -> int:
    """Sends across result lines; a line without a valid ``sends`` counts its attempt records."""
    total = 0
    for result in results:
        sends, attempts = result.get("sends"), result.get("attempts")
        if type(sends) is int and sends >= 0:
            total += sends
        elif isinstance(attempts, list):
            total += len(cast(list[Any], attempts))
    return total


def streamed_result(results: list[Record]) -> StreamedResult:
    return StreamedResult([line for line in results if not line.get("ok") and not line.get("dry_run")],
                          total_attempts(results))
