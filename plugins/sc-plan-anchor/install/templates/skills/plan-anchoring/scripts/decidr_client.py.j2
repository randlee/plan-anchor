"""Shared client for the released sc-decidr 0.2.0 Python API.

This module stays importable without the optional wheel. The wheel is loaded only
when a caller makes a decision request.
"""
from __future__ import annotations

import json
from typing import TYPE_CHECKING, Any, Callable, Mapping, Optional, Sequence, Union

if TYPE_CHECKING:
    from sc_agent import CancelToken

SC_DECIDR_VERSION = "0.2.0"
# Exact sc-agent release used as the source contract for this consumer client.
SC_AGENT_RELEASE_TAG = "prerelease/v0.2.0"
SC_AGENT_RELEASE_COMMIT = "e1f0bf94a10de80d908b1bacce86cee80ea29250"
SC_AGENT_RELEASE_URL = "https://github.com/randlee/sc-agent/releases/tag/prerelease/v0.2.0"
LogSink = Callable[[dict], None]
CategoryCodes = Mapping[str, str]
AbortOn = frozenset[str]
BatchItem = Union[str, tuple[str, Optional[dict[str, bytes]], bool]]

_ALLOWED_ABORT_ON = (frozenset(), frozenset({"auth"}), frozenset({"auth", "quota"}))


class ClientError(RuntimeError):
    """A typed client failure, including a missing optional dependency."""

    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code


def _validate_abort_on(abort_on: AbortOn) -> None:
    selected = frozenset(abort_on)
    if selected not in _ALLOWED_ABORT_ON:
        raise ValueError("abort_on must be {}, {'auth'}, or {'auth', 'quota'}")


def _result_category(line: str, sc_agent: Any) -> Optional[str]:
    try:
        result = json.loads(line)
    except (TypeError, ValueError) as exc:
        raise ClientError("DECIDR.INVALID_RESULT", "sc-decidr returned invalid JSON") from exc
    error = result.get("error") if isinstance(result, dict) else None
    if not isinstance(error, dict):
        return None
    # Ask the wheel to read the typed category from the structured error detail;
    # never infer a category from message text.
    try:
        category = sc_agent.category(json.dumps(error))
    except (AttributeError, TypeError, ValueError):
        return None
    return category if isinstance(category, str) else None


def _decode(line: str, category_codes: CategoryCodes, sc_agent: Any) -> tuple[str, Optional[str]]:
    """Return response JSON and the mapped code for an error result, if present."""
    category = _result_category(line, sc_agent)
    return line, category_codes.get(category) if category is not None else None


def _cancel_if_selected(category: Optional[str], abort_on: AbortOn, cancel: Any) -> None:
    if category in abort_on:
        cancel.cancel()


def call(
    request: str,
    *,
    model: str,
    project: str,
    agent_role: str,
    abort_on: AbortOn,
    category_codes: CategoryCodes,
    cancel: "CancelToken",
    images: Optional[dict[str, bytes]] = None,
    long_context: bool = False,
    config_dir: Optional[str] = None,
    keyring_service: Optional[str] = None,
    keyring_account: Optional[str] = None,
    general_log: Optional[LogSink] = None,
    session_log: Optional[LogSink] = None,
    timeout_secs: Optional[float] = None,
) -> tuple[str, Optional[str]]:
    """Send one decision request and return its result JSON and mapped error code."""
    _validate_abort_on(abort_on)
    try:
        import sc_agent
    except ImportError as exc:
        raise ClientError("DEPENDENCY.SC_DECIDR", f"sc-decidr 0.2.0 is required for live calls: {exc}") from exc
    kwargs = dict(model=model, project=project, agent_role=agent_role, cancel=cancel,
                  images=images, long_context=long_context, config_dir=config_dir,
                  keyring_service=keyring_service, keyring_account=keyring_account,
                  general_log=general_log, session_log=session_log)
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    try:
        line = sc_agent.send(request, **kwargs)
    except KeyboardInterrupt:
        cancel.cancel()
        raise
    except sc_agent.SagError as exc:
        category = exc.category
        _cancel_if_selected(category, abort_on, cancel)
        raise
    result = _decode(line, category_codes, sc_agent)
    _cancel_if_selected(_result_category(line, sc_agent), abort_on, cancel)
    return result


def call_batch(
    requests: Sequence[BatchItem],
    *,
    model: str,
    project: str,
    agent_role: str,
    abort_on: AbortOn,
    category_codes: CategoryCodes,
    cancel: "CancelToken",
    config_dir: Optional[str] = None,
    keyring_service: Optional[str] = None,
    keyring_account: Optional[str] = None,
    general_log: Optional[LogSink] = None,
    session_log: Optional[LogSink] = None,
    timeout_secs: Optional[float] = None,
    workers: Optional[int] = None,
    on_result: Optional[Callable[[str], None]] = None,
) -> list[tuple[str, Optional[str]]]:
    """Send a batch, preserving wheel result order and mapping each typed category."""
    _validate_abort_on(abort_on)
    try:
        import sc_agent
    except ImportError as exc:
        raise ClientError("DEPENDENCY.SC_DECIDR", f"sc-decidr 0.2.0 is required for live calls: {exc}") from exc
    def handle(line: str) -> None:
        _decode(line, category_codes, sc_agent)
        _cancel_if_selected(_result_category(line, sc_agent), abort_on, cancel)
        if on_result is not None:
            on_result(line)

    kwargs = dict(model=model, project=project, agent_role=agent_role, cancel=cancel,
                  on_result=handle, config_dir=config_dir, keyring_service=keyring_service,
                  keyring_account=keyring_account, general_log=general_log, session_log=session_log)
    if timeout_secs is not None:
        kwargs["timeout_secs"] = timeout_secs
    if workers is not None:
        kwargs["workers"] = workers
    try:
        lines = sc_agent.send_batch(requests, **kwargs)
    except KeyboardInterrupt:
        cancel.cancel()
        raise
    except sc_agent.SagError as exc:
        category = exc.category
        _cancel_if_selected(category, abort_on, cancel)
        raise
    # The wheel returns input order; callbacks above retain finish order.
    return [_decode(line, category_codes, sc_agent) for line in lines]
