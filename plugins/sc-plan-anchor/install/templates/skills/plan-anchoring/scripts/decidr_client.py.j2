            raise ClientError("DECIDR.INVALID_RESULT", "sc-decidr batch results repeat an input position")
    except (ClientError, wheel.SagError) as exc:
        return exception_result(exc, category_codes=codes, error_actions=error_actions)
    return dict(ok=True, value=[completed[position] for position in range(len(requests))])